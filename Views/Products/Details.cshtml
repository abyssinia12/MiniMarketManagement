@model MiniMarket.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show col-md-8 col-lg-6" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 col-md-8 col-lg-6">
        <div>
            <h2 class="fw-bold">Product Details</h2>
           
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 col-md-8 col-lg-6">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">ID</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Id</dd>

                <dt class="col-sm-4 text-muted">Product Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Category</dt>
                <dd class="col-sm-8">@(Model.Category?.Name ?? "N/A")</dd>

                <dt class="col-sm-4 text-muted">Barcode</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Barcode) ? "—" : Model.Barcode)</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                <dt class="col-sm-4 text-muted">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive && !Model.IsDelete)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between">
            <a asp-action="Create" class="btn btn-sm btn-outline-primary">+ Create Another Product</a>
            <a asp-action="Index" class="btn btn-sm btn-secondary">Go to Product List</a>
        </div>
    </div>
</div>
